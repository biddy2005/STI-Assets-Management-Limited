{
  "name": "asset-mgmt-site",
  "version": "1.0.0",
  "description": "Corporate website for an asset management firm - Node/Express/EJS/Prisma",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "email:test": "node --use-system-ca scripts/verify-email.js",
    "r2:migrate:public": "node scripts/migrate-public-assets-to-r2.js",
    "r2:migrate:public:execute": "node scripts/migrate-public-assets-to-r2.js --execute",
    "check:syntax": "node scripts/check-syntax.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1",
    "test:db:migrate": "node scripts/migrate-test-db.js",
    "check": "npm run check:syntax && npm run prisma:validate",
    "ci:verify": "npm run prisma:generate && npm run check && npm test",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.0",
    "helmet": "^8.1.0",
    "lucide": "^1.27.0",
    "multer": "^2.0.1",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
