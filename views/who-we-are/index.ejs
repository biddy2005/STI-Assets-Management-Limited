<%- include('../partials/header', {
  pageCss: '/css/pages/about.css'
}) %>
<!-- ============================================================
     1. HERO SECTION
============================================================ -->
<section class="inner-page-hero about-page-hero">
  <div class="inner-page-hero-inner">
    <span class="hero-eyebrow">About STIAM</span>
    <h1>Your Trusted Investment Partner</h1>
    <p>Building Wealth Through Expert Financial Management.</p>
  </div>
</section>

<!-- ============================================================
     2. WHO WE ARE
============================================================ -->
<section
  class="about-overview-section"
  aria-labelledby="about-overview-title"
>
  <div class="about-overview-container">

    <div class="about-overview-grid">

      <!-- Company overview -->
      <div class="about-overview-content">

        <div class="values-eyebrow-row about-overview-eyebrow">
          <span class="eyebrow">Who We Are</span>
        </div>

        <h2 id="about-overview-title">
          A Trusted Nigerian Investment Management Company
        </h2>

        <p class="about-overview-lead">
          STI Assets Management Limited is a wholly Nigerian-owned,
          non-bank financial company established in 2008 to provide
          investment management and financial advisory services.
        </p>

        <p class="about-overview-text">
          
        We are a wholly owned Nigerian company, dedicated to delivering innovative financial services that empower the country's business landscape, catering to the needs of both individuals and corporations. Our identity is rooted in being an exceptional, all-encompassing financial hub where limitless possibilities flourish, and where optimism always fills the glass with opportunities. This is made possible through our dedicated team and robust tools that ensure we fulfil our commitments
        </p>

        <p class="about-overview-text">
          
        The organisation is committed to operating as a professional and ethical organisation with an unmatched commitment to customer satisfaction.
        </p>

        <!-- Company highlights -->
        <div
          class="about-overview-facts"
          aria-label="STI Assets Management company information"
        >
          <div class="about-overview-fact">
            <strong>2008</strong>
            <span>Established</span>
          </div>

          <span
            class="about-overview-fact-divider"
            aria-hidden="true"
          >
            |
          </span>

          <div class="about-overview-fact">
            <strong>Nigerian-Owned</strong>
            <span>Local Expertise</span>
          </div>

          <span
            class="about-overview-fact-divider"
            aria-hidden="true"
          >
            |
          </span>

          <div class="about-overview-fact">
            <strong>Individuals &amp; Corporations</strong>
            <span>Clients We Serve</span>
          </div>
        </div>

      </div>

      <!-- Company image -->
      <div class="about-overview-visual">

        <div class="about-overview-image">
          <img
            src="/photo-1522071820081-009f0129c71c.jpg"
            alt="Investment professionals collaborating in a corporate office"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        </div>

        <div class="about-overview-experience">
          <strong>100+</strong>

          <span>
            Years of Combined<br>
            Professional Experience
          </span>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- ============================================================
     3. STRATEGIC GOALS AND FOCUS
============================================================ -->
<section
  class="about-purpose-section"
  aria-labelledby="about-purpose-title"
>
  <div class="about-purpose-container">

    <!-- Section heading -->
    <div class="about-purpose-header">

      <div class="values-eyebrow-row">
        <span class="eyebrow">Our Purpose</span>
      </div>

      <h2 id="about-purpose-title">
        Driven by Purpose. Focused on Impact.
      </h2>

      <p>
        Our strategic focus is to create meaningful wealth opportunities
        while building a responsive and dependable investment management
        firm.
      </p>

    </div>

    <!-- Strategic focus cards -->
    <div
      class="about-purpose-grid"
      role="list"
      aria-label="STI Assets Management strategic focus"
    >

      <!-- Wealth creation -->
      <article
        class="about-purpose-card about-purpose-card-primary"
        role="listitem"
      >

        <div class="about-purpose-card-content">

          <h3>
            Creating Opportunities for Growing Wealth
          </h3>

          <p>
            We serve Nigeria's growing and emerging affluent market
            with investment solutions designed to help clients identify
            and maximise wealth creation opportunities.
          </p>

        </div>

      </article>

      <!-- Agile investment management -->
      <article
        class="about-purpose-card about-purpose-card-secondary"
        role="listitem"
      >

        <div class="about-purpose-card-content">

          <h3>
            Building a Responsive Advisory Firm
          </h3>

          <p>
            We are building an asset management and investment advisory
            firm that is agile, dependable and focused on delivering
            superior outcomes for every client.
          </p>

        </div>

      </article>

    </div>

  </div>
</section>

