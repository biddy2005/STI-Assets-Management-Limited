<%- include('../partials/header', {
  pageCss: '/css/pages/about.css',
  pageTitle: 'Who We Are | STI Assets Management Limited',
  pageDescription: 'STI Assets Management Limited is a wholly Nigerian-owned, SEC-regulated investment management and financial advisory firm established in 2008.'
}) %>

<main id="main-content">

  <!-- ============================================================
       1. HERO
       Compact counterpart to the homepage hero. Same left
       alignment, same type, roughly half the height.
  ============================================================ -->
  <section class="page-hero" aria-labelledby="about-hero-title">
    <div class="page-hero-media" aria-hidden="true">
      <img
        src="/hero-poster.webp"
        alt=""
        fetchpriority="high"
        decoding="async"
      >
    </div>

    <div class="page-hero-overlay" aria-hidden="true"></div>

    <div class="page-shell page-hero-inner">
      <div class="page-hero-copy">
        <nav class="page-breadcrumb page-enter" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Who we are</span>
        </nav>

        <h1
          id="about-hero-title"
          class="page-hero-title page-enter"
          style="--page-enter-delay: 120ms"
        >
          Nigerian owned. Built for the long term.
        </h1>

        <p
          class="page-hero-summary page-enter"
          style="--page-enter-delay: 240ms"
        >
          Since 2008 we have managed capital for individuals, corporates and
          institutions across Nigeria, under a licence from the Securities and
          Exchange Commission.
        </p>
      </div>
    </div>
  </section>


  <!-- ============================================================
       2. OVERVIEW
       Asymmetric split with the fact row, which was already the
       strongest element on the previous version of this page.
  ============================================================ -->
  <section class="page-band page-band-light" aria-labelledby="about-overview-title">
    <div class="page-shell">
      <div class="page-split">

         <div class="reveal-on-scroll">
          <p class="page-eyebrow">Who we are</p>

          <h2 id="about-overview-title" class="page-title-sm">
            A trusted Nigerian investment management company.
          </h2>

          <div class="page-prose" style="margin-top: 22px;">
            <p>
              STI Assets Management Limited is a wholly Nigerian-owned, non-bank
              financial company established in 2008 to provide investment
              management and financial advisory services.
            </p>

            <p>
              We deliver financial services built around the needs of both
              individuals and corporations, supported by a dedicated team and
              the tools required to meet the commitments we make.
            </p>

            <p>
              The organisation is committed to operating professionally and
              ethically, with an unmatched commitment to client satisfaction.
            </p>
          </div>

          <div class="page-facts" aria-label="Company information">
            <div class="page-fact">
              <strong class="page-fact-value">2008</strong>
              <span class="page-fact-label">Established</span>
            </div>

            <div class="page-fact">
              <strong class="page-fact-value">Nigerian owned</strong>
              <span class="page-fact-label">Local expertise</span>
            </div>

            <div class="page-fact">
              <strong class="page-fact-value">Individuals &amp; corporates</strong>
              <span class="page-fact-label">Clients we serve</span>
            </div>
          </div>
        </div>

        <div class="page-media reveal-on-scroll reveal-zoom" style="--reveal-delay: 120ms">
          <img
          src="/reception-768.webp"
          alt="A member of the STI Assets Management team at the 2025 Annual General Meeting"
            loading="lazy"
            decoding="async"
          >

          <div class="page-media-badge">
            <strong>10+</strong>
            <span>Years combined experience</span>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ============================================================
       3. PURPOSE — polarity flip
       The homepage alternates white and navy bands. Without this
       an inner page reads flat however good the content is.
  ============================================================ -->
  <section class="page-band page-band-ink" aria-labelledby="about-purpose-title">
    <div class="page-shell">

      <div class="page-section-head reveal-on-scroll">
        <p class="page-eyebrow page-eyebrow-light">Our purpose</p>

        <h2 id="about-purpose-title" class="page-title-sm page-title-light">
          Driven by purpose. Focused on impact.
        </h2>

        <p class="page-lead">
          Our strategic focus is to create meaningful wealth opportunities while
          building a responsive and dependable investment management firm.
        </p>
      </div>

            <ol class="page-statement-list">
        <li class="page-statement reveal-on-scroll" style="--reveal-delay: 80ms">
          <span class="page-statement-num" aria-hidden="true">01</span>
          <div>
            <h3 class="page-statement-title">Meaningful wealth opportunities</h3>
            <p class="page-statement-text">
              We identify and structure investments that serve a defined
              objective, rather than selling products in search of a buyer.
              Every mandate begins with what the capital is for.
            </p>
          </div>
        </li>

        <li class="page-statement reveal-on-scroll" style="--reveal-delay: 140ms">
          <span class="page-statement-num" aria-hidden="true">02</span>
          <div>
            <h3 class="page-statement-title">A dependable institution</h3>
            <p class="page-statement-text">
              Responsiveness and reliability are operational commitments, not
              marketing claims. Clients receive statements on a fixed schedule
              and reach a named contact when they call.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>


  <!-- ============================================================
       4. VISION AND MISSION
  ============================================================ -->
  <section class="page-band page-band-soft" aria-labelledby="about-direction-title">
    <div class="page-shell">

      <div class="page-section-head reveal-on-scroll">
        <p class="page-eyebrow">Our direction</p>

        <h2 id="about-direction-title" class="page-title-sm">
          Where we are going, and how we get there.
        </h2>
      </div>

            <div class="page-declarations">
        <div class="page-declaration reveal-on-scroll">
          <p class="page-eyebrow">Vision</p>
          <p class="page-declaration-text">
            The foremost financial enterprise that consistently demonstrates superior competency in progressive wealth creation and preservation
          </p>
        </div>

        <div class="page-declaration reveal-on-scroll" style="--reveal-delay: 100ms">
          <p class="page-eyebrow">Mission</p>
          <p class="page-declaration-text">
            To provide distinctive and relatable innovative investment solutions that are inclusive, rewarding and sustainable
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       BREATHER
       A full-bleed image between two text-heavy bands. No copy
       over it; its job is to give the eye somewhere to rest.
  ============================================================ -->
  <section class="page-breather reveal-on-scroll reveal-zoom" aria-hidden="true">
    <img
      src="/pexels-hilalbulbul-37293743.jpg"
      alt=""
      loading="lazy"
      decoding="async"
    >
  </section>

  <!-- ============================================================
       5. CORE VALUES
       Five values in a 3+2 grid. Left aligned, no centred headers.
  ============================================================ -->
  <section class="page-band page-band-light" aria-labelledby="about-values-title">
    <div class="page-shell">

     <div class="page-section-head reveal-on-scroll">
        <p class="page-eyebrow">Our core values</p>

        <h2 id="about-values-title" class="page-title-sm">
          Built on values. Driven by purpose.
        </h2>

        <p class="page-lead">
          Every relationship we build and every decision we make is anchored in
          the principles that define who we are as an organisation.
        </p>
      </div>

      <div class="page-grid page-grid-3">

        <article class="page-card page-card-lift reveal-on-scroll">
          <span class="page-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 11 2 2 4-4"></path><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
          </span>
          <h3 class="page-card-title">Client first</h3>
          <p class="page-card-text">
            Your objectives, liquidity needs and risk tolerance are written down
            before capital is deployed, and we do not take a position outside
            them.
          </p>
        </article>

        <article class="page-card page-card-lift reveal-on-scroll" style="--reveal-delay: 60ms">
          <span class="page-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </span>
          <h3 class="page-card-title">Collaboration</h3>
          <p class="page-card-text">
            Research, advisory and portfolio management work from the same
            information, so the advice you receive reflects the whole firm rather
            than one desk.
          </p>
        </article>

         <article class="page-card page-card-lift reveal-on-scroll" style="--reveal-delay: 120ms">
          <span class="page-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path></svg>
          </span>
          <h3 class="page-card-title">Accountability</h3>
          <p class="page-card-text">
            We report on what we said we would do, on a fixed schedule, including
            when the result falls short of the objective.
          </p>
        </article>

        <article class="page-card page-card-lift reveal-on-scroll">
          <span class="page-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8a5 5 0 0 1-6 0Z"></path><path d="m2 16 3-8 3 8a5 5 0 0 1-6 0Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h18"></path></svg>
          </span>
          <h3 class="page-card-title">Integrity</h3>
          <p class="page-card-text">
            Client assets sit with an independent custodian. Fees are disclosed
            in full before you commit, not discovered afterwards.
          </p>
        </article>

         <article class="page-card page-card-lift reveal-on-scroll" style="--reveal-delay: 60ms">
          <span class="page-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12l4 6-10 13L2 9Z"></path><path d="m11 3-3 6 4 13 4-13-3-6"></path><path d="M2 9h20"></path></svg>
          </span>
          <h3 class="page-card-title">Excellence</h3>
          <p class="page-card-text">
            Professional standards are held consistently, from a first enquiry
            through to the administration of a corporate scheme.
          </p>
        </article>

        <!--
          The sixth cell carries the onward action rather than a
          sixth value, so the grid resolves without an empty gap.
        -->
        <article class="page-card page-card-ink reveal-on-scroll" style="--reveal-delay: 120ms">
          <h3 class="page-card-title">Work with us</h3>
          <p class="page-card-text">
            Tell an advisor what the capital is for and the horizon you have in
            mind. We will tell you which mandate fits, or whether none of them
            do.
          </p>

          <div style="margin-top: auto; padding-top: 24px;">
            <a href="/contact" class="page-text-link page-text-link-light">
              Speak with an advisor
              <svg class="ui-icon ui-icon-sm" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
            </a>
          </div>
        </article>

      </div>
    </div>
  </section>

</main>

<%- include('../partials/footer') %>
