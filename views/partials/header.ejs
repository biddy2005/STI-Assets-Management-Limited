<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <%
    const metaTitle =
      typeof title !== 'undefined' && title
        ? `${title} | STI Assets Management`
        : 'STI Assets Management';

    const metaDescription =
      typeof description !== 'undefined' && description
        ? description
        : 'STI Assets Management Limited provides investment management, financial advisory, market research and portfolio solutions for individuals and organisations.';

    const canonicalHref =
      typeof canonicalPath !== 'undefined' && canonicalPath
        ? `https://stiassetmgt.com${canonicalPath}`
        : null;

    const socialImage =
      typeof ogImage !== 'undefined' && ogImage
        ? ogImage
        : null;

    const socialType =
      typeof ogType !== 'undefined' && ogType
        ? ogType
        : 'website';
  %>

  <title><%= metaTitle %></title>

  <meta
    name="description"
    content="<%= metaDescription %>"
  >

  <meta
    name="theme-color"
    content="#033669"
  >

  <link
    rel="icon"
    type="image/png"
    href="/croppedstilogo.png"
  >


  <% if (typeof robots !== 'undefined' && robots) { %>

    <meta
      name="robots"
      content="<%= robots %>"
    >

  <% } %>


  <% if (canonicalHref) { %>

    <link
      rel="canonical"
      href="<%= canonicalHref %>"
    >

  <% } %>


  <!-- Open Graph -->

  <meta
    property="og:title"
    content="<%= metaTitle %>"
  >

  <meta
    property="og:description"
    content="<%= metaDescription %>"
  >

  <meta
    property="og:type"
    content="<%= socialType %>"
  >

  <meta
    property="og:site_name"
    content="STI Assets Management"
  >

  <meta
    property="og:locale"
    content="en_NG"
  >


  <% if (canonicalHref) { %>

    <meta
      property="og:url"
      content="<%= canonicalHref %>"
    >

  <% } %>


  <% if (socialImage) { %>

    <meta
      property="og:image"
      content="<%= socialImage %>"
    >

  <% } %>


  <!-- Social sharing -->

  <meta
    name="twitter:card"
    content="<%= socialImage ? 'summary_large_image' : 'summary' %>"
  >

  <meta
    name="twitter:title"
    content="<%= metaTitle %>"
  >

  <meta
    name="twitter:description"
    content="<%= metaDescription %>"
  >


  <% if (socialImage) { %>

    <meta
      name="twitter:image"
      content="<%= socialImage %>"
    >

  <% } %>


  <!-- Styles -->

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
  <link
    rel="stylesheet"
    href="/css/page-system.css?v=1"
  >

  <% if (
    typeof pageCss !== 'undefined' &&
    pageCss
  ) { %>

    <link
      rel="stylesheet"
      href="<%= pageCss %>"
    >

  <% } %>

</head>

<body>

  <!-- =========================================================
       GLOBAL PAGE LOADER
  ========================================================== -->
  <div
    id="siteLoader"
    class="site-loader is-hidden"
    role="status"
    aria-live="polite"
    aria-label="Loading page"
    aria-hidden="true"
  >
    <div class="site-loader-inner">

      <div
        class="site-loader-mark"
        aria-hidden="true"
      >
        <span class="site-loader-ring"></span>

        <img
          src="/croppedstilogo.png"
          alt=""
          width="53"
          height="71"
        >
      </div>

      <p class="site-loader-brand">
        STI Assets Management
      </p>

    </div>
  </div>

  <!--
    Page-loader bootstrap.

    The loader starts hidden. This runs immediately after its
    markup so JavaScript can initialise every reset path before
    opting the document into the enhanced loader state.
  -->
  <script
    src="/js/page-loader.js?v=3"
  ></script>

  <%- include('nav') %>

  <main class="site-main">
