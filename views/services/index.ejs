<%- include('../partials/header', {
  pageCss: '/css/pages/services.css'
}) %>
<!-- ============================================================
     PAGE HEADER
============================================================ -->
<section class="inner-page-hero services-page-hero">
  <div class="inner-page-hero-inner">
    <span class="hero-eyebrow">Our Solutions</span>
    <h1>Tailored Strategies. Proven Expertise.</h1>
    <p>We are dedicated to building lasting relationships with our clients based on trust, transparency, and a shared commitment to achieving your financial vision.</p>
  </div>
</section>

<!-- ============================================================
     SERVICE 1: FINANCIAL ADVISORY SERVICES
============================================================ -->
<section
  id="financial-advisory"
  class="section service-block service-block-white service-advisory-section"
>
  <div class="service-split">

    <article class="service-intro">

      <div class="service-intro-image">
        <img
          src="/financialadvisory.jpg"
          alt="Financial advisor meeting with a client"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div class="service-intro-text">

        <div
          class="service-section-index service-section-index-left"
        >
          <span class="service-section-number">
            01
          </span>
        </div>

        <h2>Financial Advisory Services</h2>

        <p>
          Financial advisory is the cornerstone of our commitment to you. We work closely with every client to understand their goals and build a strategy that stands the test of time, grounded in expertise and tailored to your unique circumstances.
        </p>

      </div>
    </article>

    <div
      class="service-feature-stack"
      aria-label="Financial advisory capabilities"
    >

      <article class="service-feature">

        <div class="service-feature-icon">
          <svg
            class="ui-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
        </div>

        <div class="service-feature-copy">
          <h3>Risk Assessment</h3>
          <p>
            We assess your risk profile to determine the best investment strategy for you.
          </p>
        </div>

      </article>

      <article class="service-feature">

        <div class="service-feature-icon">
          <svg
            class="ui-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <rect
                width="8"
                height="4"
                x="8"
                y="2"
                rx="1"
                ry="1"
              ></rect>

              <path
                d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
              ></path>

              <path d="M12 11h4"></path>
              <path d="M12 16h4"></path>
              <path d="M8 11h.01"></path>
              <path d="M8 16h.01"></path>
          </svg>
        </div>

        <div class="service-feature-copy">
          <h3>Financial Planning</h3>
          <p>
            We create a comprehensive financial plan that includes budgeting, savings, and investment strategies.
          </p>
        </div>

      </article>

      <article class="service-feature">

        <div class="service-feature-icon">
          <svg
            class="ui-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle
              cx="12"
              cy="12"
              r="9"
            ></circle>
            <path d="M12 7v5l3 3"></path>
          </svg>
        </div>

        <div class="service-feature-copy">
          <h3>Retirement Planning</h3>
          <p>
            We help you prepare for a comfortable and secure retirement through retirement account management and income planning.
          </p>
        </div>

      </article>

    </div>
  </div>
</section>

<!-- ============================================================
     SERVICE 2: MARKET RESEARCH
============================================================ -->
<section
  id="market-research"
  class="section service-block service-block-alt service-research-section"
>
  <div class="section-header-center">

    <div class="service-section-index">
      <span class="service-section-number">
        02
      </span>
    </div>

    <h2>Market Research</h2>

    <p class="section-lead">
      We equip our clients with timely, rigorous research to inform every investment decision.
    </p>

  </div>

  <div class="service-research-grid">

    <article class="research-card">

      <div class="research-card-image">
        <img
          src="/globalmarket.webp"
          alt="Global stock market data on a trading screen"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div class="research-card-body">
        <h3>Global Market Updates</h3>

        <p>
          Summary of daily domestic and global market activities to aid better portfolio diversification understanding.
        </p>

      </div>
    </article>

    <article class="research-card">

      <div class="research-card-image">
        <img
          src="/economicanalysis.webp"
          alt="Economic indicators displayed on an analytics dashboard"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div class="research-card-body">
        <h3>Economic Analysis</h3>

        <p>
          Regular updates on economic indicators and their potential impact on your investments.
        </p>

      </div>
    </article>

    <article class="research-card">

      <div class="research-card-image">
        <img
          src="/sectoranalysispic.jpg"
          alt="Bar chart comparing performance across market sectors"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div class="research-card-body">
        <h3>Sector Analysis</h3>

        <p>
          In-depth sector-specific research to identify opportunities and risks.
        </p>

      </div>
    </article>

    <article class="research-card">

      <div class="research-card-image">
        <img
          src="/companyanalysispic.jpg"
          alt="Analyst reviewing a company financial report"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div class="research-card-body">
        <h3>Company Analysis</h3>

        <p>
          Detailed analysis of individual companies to guide your investment choices.
        </p>

      </div>
    </article>

  </div>
</section>

<!-- ============================================================
     SERVICE 3: PORTFOLIO AND FUND MANAGEMENT
============================================================ -->
<section
  id="portfolio-fund-management"
  class="section service-block service-block-white service-portfolio-section"
>
  <div class="section-header-center">

    <div class="service-section-index">
      <span class="service-section-number">
        03
      </span>
    </div>

    <h2>Portfolio and Fund Management</h2>

    <p class="section-lead">
      Our flagship management services are built to match every client's risk appetite and investment horizon.
    </p>

  </div>

  <div class="service-portfolio-grid">

    <article class="portfolio-service-card">

      <div class="portfolio-card-media">
        <img
          src="/corporate.jpg"
          alt="Modern commercial buildings representing portfolio management"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div
        class="portfolio-card-overlay"
        aria-hidden="true"
      ></div>

      <div class="portfolio-card-content">
        <h3>Discretionary Portfolio Management</h3>

        <p>
          Experienced portfolio managers actively managing your investments to capitalize on market opportunities.
        </p>
      </div>

    </article>

    <article class="portfolio-service-card">

      <div class="portfolio-card-media">
        <img
          src="/modelportfolio.jpg"
          alt="Financial documents and calculator representing model portfolios"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div
        class="portfolio-card-overlay"
        aria-hidden="true"
      ></div>

      <div class="portfolio-card-content">
        <h3>Model Portfolios</h3>

        <p>
          Diversified selections designed to match different risk profiles for individual and corporate clients.
        </p>
      </div>

    </article>

    <article class="portfolio-service-card">

      <div class="portfolio-card-media">
        <img
          src="/mutualfunds.webp"
          alt="Market chart representing mutual fund investments"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div
        class="portfolio-card-overlay"
        aria-hidden="true"
      ></div>

      <div class="portfolio-card-content">
        <h3>Mutual Funds</h3>

        <p>
          Access to a wide range of mutual funds carefully selected to meet various investment needs.
        </p>
      </div>

    </article>

    <article class="portfolio-service-card">

      <div class="portfolio-card-media">
        <img
          src="/alternativeinvestment.jpg"
          alt="Modern property representing alternative investments"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div
        class="portfolio-card-overlay"
        aria-hidden="true"
      ></div>

      <div class="portfolio-card-content">
        <h3>Alternative Investments</h3>

        <p>
          Opportunities to diversify with alternative assets such as real estate, private equity, and hedge funds.
        </p>
      </div>

    </article>

  </div>
</section>

<!-- ============================================================
     SERVICE 4: CORPORATE INVESTMENT SCHEMES
============================================================ -->
