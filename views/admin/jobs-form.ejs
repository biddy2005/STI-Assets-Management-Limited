<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= job ? 'Edit Job Posting' : 'New Job Posting' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a href="/admin/dashboard" class="logo">STIAM Admin</a>
      <form action="/auth/logout" method="POST">
          <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >
        <button class="btn-nav" type="submit">Log Out</button></form>
    </div>
  </header>

  <section class="section">
    <h1><%= job ? 'Edit Job Posting' : 'New Job Posting' %></h1>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <form action="<%= job ? '/admin/jobs/' + job.id : '/admin/jobs' %>" method="POST" class="form">
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >
      <label>Title
        <input type="text" name="title" value="<%= job ? job.title : '' %>" required>
      </label>
      <label>Department
        <input type="text" name="department" value="<%= job ? job.department : '' %>" required>
      </label>
      <label>
        Location
        <input
          type="text"
          name="location"
          value="<%= job ? job.location : '' %>"
          required
        >
      </label>

      <label>
        Job Category
        <input
          type="text"
          name="jobCategory"
          value="<%= job && job.jobCategory ? job.jobCategory : '' %>"
          placeholder="e.g. Hybrid, On-site or Remote"
          maxlength="50"
        >
      </label>

      <label>
        Job Type
        <input
          type="text"
          name="jobType"
          value="<%= job && job.jobType ? job.jobType : '' %>"
          placeholder="e.g. Full Time, Part Time or Internship"
          maxlength="50"
        >
      </label>

      <label>
        Job Summary
        <textarea
          name="description"
          rows="5"
          required
          placeholder="Provide a short overview of the role."
        ><%= job ? job.description : '' %></textarea>
      </label>

      <label>
        Duties and Responsibilities
        <textarea
          name="responsibilities"
          rows="10"
          placeholder="Enter one responsibility per line."
        ><%= job && job.responsibilities ? job.responsibilities : '' %></textarea>
      </label>

      <label>
        Educational &amp; Professional Qualifications
        <textarea
          name="qualifications"
          rows="6"
          placeholder="Enter one qualification per line."
        ><%= job && job.qualifications ? job.qualifications : '' %></textarea>
      </label>

      <label>
        Experience
        <textarea
          name="experience"
          rows="5"
          placeholder="Enter one experience requirement per line."
        ><%= job && job.experience ? job.experience : '' %></textarea>
      </label>

      <label>
        Competency Requirements
        <textarea
          name="competencies"
          rows="8"
          placeholder="Enter one competency per line."
        ><%= job && job.competencies ? job.competencies : '' %></textarea>
      </label>

      <label>Application Deadline
        <input type="date" name="deadline" value="<%= job && job.deadline ? job.deadline.toISOString().slice(0,10) : '' %>">
      </label>
      <label>Status
        <select name="status">
          <option value="open" <%= job && job.status === 'open' ? 'selected' : '' %>>Open</option>
          <option value="closed" <%= job && job.status === 'closed' ? 'selected' : '' %>>Closed</option>
        </select>
      </label>
      <button type="submit" class="btn-primary"><%= job ? 'Save Changes' : 'Create Job Posting' %></button>
    </form>
  </section>
</body>
</html>