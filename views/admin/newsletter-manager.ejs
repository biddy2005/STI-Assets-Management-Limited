<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Newsletter Subscribers</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a href="/admin/dashboard" class="logo">STIAM Admin</a>
      <form action="/auth/logout" method="POST">
                  <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                  >
        <button class="btn-nav" type="submit">Log Out</button></form>
    </div>
  </header>

  <section class="section">
    <h1>Newsletter Subscribers</h1>
    <%
      const activeSubscribers =
        subscribers.filter(
          (sub) =>
            sub.isSubscribed
        ).length;

      const unsubscribedSubscribers =
        subscribers.length -
        activeSubscribers;
    %>

    <p>
      <strong><%= activeSubscribers %></strong>
      active subscriber<%= activeSubscribers === 1 ? '' : 's' %>
      &nbsp;|&nbsp;
      <strong><%= unsubscribedSubscribers %></strong>
      unsubscribed
      &nbsp;|&nbsp;
      <strong><%= subscribers.length %></strong>
      total
    </p>

    <div class="card-grid">
        <% subscribers.forEach(function(sub) { %>
          <div class="card">
    <h3><%= sub.email %></h3>

    <p>
      <span
        class="newsletter-status <%= sub.isSubscribed
          ? 'newsletter-status--subscribed'
          : 'newsletter-status--unsubscribed' %>"
      >
        <%= sub.isSubscribed
          ? 'Subscribed'
          : 'Unsubscribed' %>
      </span>
    </p>

    <p>
      <small>
        Subscribed:
        <%= sub.subscribedAt.toLocaleString() %>
      </small>
    </p>

    <% if (!sub.isSubscribed && sub.unsubscribedAt) { %>
      <p>
        <small>
          Unsubscribed:
          <%= sub.unsubscribedAt.toLocaleString() %>
        </small>
      </p>
    <% } %>

    <form
      action="/admin/newsletter/<%= sub.id %>/delete"
      method="POST"
      data-confirm="Permanently remove this newsletter record?"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <button
        type="submit"
        class="btn-outline"
      >
        Remove
      </button>
    </form>
  </div>
      <% }) %>
      <% if (subscribers.length === 0) { %>
        <p>No newsletter subscription records yet.</p>
      <% } %>
    </div>
  </section>
  <script src="/js/admin-confirm.js"></script>
</body>
</html>