<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Newsletter Subscribers</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a href="/admin/dashboard" class="logo">AssetCo Admin</a>
      <form action="/auth/logout" method="POST">
                  <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                  >
        <button class="btn-nav" type="submit">Log Out</button></form>
    </div>
  </header>

  <section class="section">
    <h1>Newsletter Subscribers</h1>
    <p><%= subscribers.length %> total subscriber<%= subscribers.length === 1 ? '' : 's' %></p>

    <div class="card-grid">
      <% subscribers.forEach(function(sub) { %>
        <div class="card">
          <h3><%= sub.email %></h3>
          <p><small>Subscribed: <%= sub.subscribedAt.toLocaleString() %></small></p>
            <form
              action="/admin/newsletter/<%= sub.id %>/delete"
              method="POST"
              data-confirm="Remove this subscriber from the newsletter?"
            >
                      <input
                        type="hidden"
                        name="_csrf"
                        value="<%= csrfToken %>"
                      >

              <button
                type="submit"
                class="btn-outline"
              >
                Remove
              </button>
            </form>
        </div>
      <% }) %>
      <% if (subscribers.length === 0) { %>
        <p>No subscribers yet.</p>
      <% } %>
    </div>
  </section>
  <script src="/js/admin-confirm.js"></script>
</body>
</html>