<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Applications</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a href="/admin/dashboard" class="logo">STIAM Admin</a>
      <form action="/auth/logout" method="POST">
          <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >
        <button class="btn-nav" type="submit">Log Out</button></form>
    </div>
  </header>

  <section class="section">
    <h1>Job Applications</h1>

    <form method="GET" action="/admin/applications" class="form" style="flex-direction: row; align-items: center; gap: 12px;">
      <label style="flex-direction: row; gap: 8px; align-items: center;">
        Filter by job:
            <select
              name="jobId"
              data-auto-submit
            >
          <option value="">All jobs</option>
          <% jobs.forEach(function(job) { %>
            <option value="<%= job.id %>" <%= jobIdFilter === job.id ? 'selected' : '' %>><%= job.title %></option>
          <% }) %>
        </select>
      </label>
    </form>

    <div class="card-grid">
      <% applications.forEach(function(app) { %>
        <div class="card">
          <h3><%= app.applicantName %></h3>
          <p><%= app.job.title %></p>
          <p><%= app.email %><% if (app.phone) { %> · <%= app.phone %><% } %></p>
          <p>Submitted: <%= app.submittedAt.toDateString() %></p>
          <% if (app.coverNote) { %><p><%= app.coverNote %></p><% } %>
          <p>
  <a
    href="/admin/applications/<%= app.id %>/resume"
    class="btn-text"
  >
    Download résumé
  </a>
</p>

<p>
  <small>
    Original file:
    <%= app.resumeOriginalName %>
  </small>
</p>

<p>
  <small>
    File size:
    <%= (
      app.resumeFileSize /
      (1024 * 1024)
    ).toFixed(2) %> MB
  </small>
</p>

<p>
  <strong>Privacy notice:</strong>

  <% if (app.privacyAcknowledged) { %>
    Acknowledged
  <% } else { %>
    Not recorded
  <% } %>
</p>

<% if (app.privacyAcknowledgedAt) { %>
  <p>
    <strong>Acknowledged on:</strong>

    <%= new Date(
      app.privacyAcknowledgedAt
    ).toLocaleString('en-NG') %>
  </p>
<% } %>

<% if (app.privacyNoticeVersion) { %>
  <p>
    <strong>Notice version:</strong>
    <%= app.privacyNoticeVersion %>
  </p>
<% } %>

<!-- Application status update form -->
<form
  action="/admin/applications/<%= app.id %>/status"
  method="POST"
  class="application-status-form"
>
  <input
    type="hidden"
    name="_csrf"
    value="<%= csrfToken %>"
  >

  <label>
    Application status

    <select
      name="status"
      required
    >
      <option
        value="NEW"
        <%= app.status === 'NEW' ? 'selected' : '' %>
      >
        New
      </option>

      <option
        value="REVIEWING"
        <%= app.status === 'REVIEWING' ? 'selected' : '' %>
      >
        Reviewing
      </option>

      <option
        value="SHORTLISTED"
        <%= app.status === 'SHORTLISTED' ? 'selected' : '' %>
      >
        Shortlisted
      </option>

      <option
        value="REJECTED"
        <%= app.status === 'REJECTED' ? 'selected' : '' %>
      >
        Rejected
      </option>

      <option
        value="HIRED"
        <%= app.status === 'HIRED' ? 'selected' : '' %>
      >
        Hired
      </option>
    </select>
  </label>

  <button
    type="submit"
    class="btn-primary"
  >
    Update Status
  </button>
</form>

<!-- Application deletion form -->
<form
  action="/admin/applications/<%= app.id %>/delete"
  method="POST"
  data-confirm="Delete this application and its résumé?"
>
  <input
    type="hidden"
    name="_csrf"
    value="<%= csrfToken %>"
  >

  <button
    type="submit"
    class="btn-outline"
  >
    Delete
  </button>
</form>

        </div>
      <% }) %>
      <% if (applications.length === 0) { %>
        <p>No applications found.</p>
      <% } %>
    </div>
  </section>
  <script src="/js/admin-confirm.js"></script>
</body>
</html>