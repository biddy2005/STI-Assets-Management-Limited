<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Subscription Applications</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a href="/admin/dashboard" class="logo">STIAM Admin</a>
      <form action="/auth/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn-nav" type="submit">Log Out</button>
      </form>
    </div>
  </header>

  <section class="section">
    <h1>Subscription Applications</h1>

    <form
      method="GET"
      action="/admin/subscriptions"
      class="form"
      style="flex-direction: row; align-items: center; gap: 12px;"
    >
      <label style="flex-direction: row; gap: 8px; align-items: center;">
        Filter by status:
        <select name="status" data-auto-submit>
          <option value="">All statuses</option>
          <% statuses.forEach(function (status) { %>
            <option
              value="<%= status %>"
              <%= statusFilter === status ? 'selected' : '' %>
            ><%= status.replace(/_/g, ' ') %></option>
          <% }) %>
        </select>
      </label>
    </form>

    <p style="color: #5b6b78; font-size: 0.9rem;">
      <%= subscriptions.length %> application<%= subscriptions.length === 1 ? '' : 's' %>.
      BVN and NIN are stored encrypted and are shown here only as the last four
      digits. Open a record to reveal the full values.
    </p>

    <% if (!subscriptions.length) { %>
      <p>No subscription applications yet.</p>
    <% } else { %>
      <div style="overflow-x: auto;">
        <table class="table" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr>
              <th style="text-align: left; padding: 10px;">Reference</th>
              <th style="text-align: left; padding: 10px;">Client</th>
              <th style="text-align: left; padding: 10px;">Product</th>
              <th style="text-align: right; padding: 10px;">Principal</th>
              <th style="text-align: left; padding: 10px;">Tenor</th>
              <th style="text-align: left; padding: 10px;">BVN</th>
              <th style="text-align: left; padding: 10px;">Status</th>
              <th style="text-align: left; padding: 10px;">M365</th>
              <th style="text-align: left; padding: 10px;">Received</th>
              <th style="padding: 10px;"></th>
            </tr>
          </thead>

          <tbody>
            <% subscriptions.forEach(function (item) { %>
              <tr style="border-top: 1px solid #e6ebf0;">
                <td style="padding: 10px; font-family: monospace;">
                  <%= item.reference %>
                </td>

                <td style="padding: 10px;">
                  <strong><%= [item.firstName, item.middleName, item.surname].filter(Boolean).join(' ') %></strong><br />
                  <span style="color: #5b6b78; font-size: 0.85rem;">
                    <%= item.email %><br /><%= item.phone %>
                  </span>
                </td>

                <td style="padding: 10px; font-size: 0.85rem;">
                  <%= item.product.replace(/_/g, ' ') %>
                </td>

                <td style="padding: 10px; text-align: right; font-variant-numeric: tabular-nums;">
                  <%= Number(item.principalAmount).toLocaleString('en-NG') %>
                </td>

                <td style="padding: 10px; font-size: 0.85rem;">
                  <%= item.fixedDepositTenor %>
                </td>

                <td style="padding: 10px; font-family: monospace; color: #5b6b78;">
                  &bull;&bull;&bull;&bull;&bull;&bull;&bull;<%= item.bvnLast4 %>
                </td>

                <td style="padding: 10px;">
                  <%
                    const statusClass =
                      item.status === 'APPROVED'
                        ? 'is-approved'
                        : item.status === 'REJECTED'
                          ? 'is-rejected'
                          : '';
                  %>
                  <span class="status-pill <%= statusClass %>"><%= item.status.replace(/_/g, ' ') %></span>
                </td>

                <td style="padding: 10px; font-size: 0.8rem;">
                  <% if (item.forwardedToPowerAutomate) { %>
                    <span class="state-ok">Sent</span>
                  <% } else if (item.forwardingError) { %>
                    <span class="state-fail" title="<%= item.forwardingError %>">Failed</span>
                  <% } else { %>
                    <span class="state-idle">Pending</span>
                  <% } %>
                </td>

                <td style="padding: 10px; font-size: 0.85rem; color: #5b6b78;">
                  <%= new Date(item.createdAt).toLocaleDateString('en-GB', {
                    day: '2-digit', month: 'short', year: 'numeric'
                  }) %>
                </td>

                <td style="padding: 10px;">
                  <a href="/admin/subscriptions/<%= item.id %>">Open</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <p style="margin-top: 24px;">
      <a href="/admin/dashboard">Back to dashboard</a>
    </p>
  </section>
</body>
</html>
