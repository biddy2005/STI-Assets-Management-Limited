<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Manage Rate Guide | Admin
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>


<body>

  <header class="site-header">

    <div class="nav-wrap">

      <a
        href="/admin/dashboard"
        class="logo"
      >
        STIAM Admin
      </a>


      <form
        action="/auth/logout"
        method="POST"
      >

        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >

        <button
          class="btn-nav"
          type="submit"
        >
          Log Out
        </button>

      </form>

    </div>

  </header>


  <section class="section">

    <h1>
      Manage Rate Guide
    </h1>

    <p>
      <a href="/admin/dashboard">
        &larr; Back to Dashboard
      </a>
    </p>


    <% if (success) { %>

      <p class="admin-rate-guide-success">
        Rate Guide updated successfully.
      </p>

    <% } %>


    <% if (error) { %>

      <p class="admin-rate-guide-error">
        <%= error %>
      </p>

    <% } %>


    <div class="card admin-rate-guide-card">

      <h3>
        Current Rate Guide
      </h3>


      <% if (rateGuide) { %>

        <div class="admin-rate-guide-preview">

          <img
            src="<%= rateGuide.imageUrl %>"
            alt="Current Rate Guide"
          >

        </div>


        <p>
          <strong>Current file:</strong>
          <%= rateGuide.originalName %>
        </p>


        <p>
          <strong>Last updated:</strong>
          <%= rateGuide.updatedAt.toLocaleString() %>
        </p>

      <% } else { %>

        <p>
          No Rate Guide has been uploaded through Admin yet.
          The public Products page is currently using the
          fallback Rate Guide image.
        </p>

      <% } %>


      <form
        action="/admin/rate-guide"
        method="POST"
        enctype="multipart/form-data"
        class="form"
      >

        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >


        <label>

          <%= rateGuide
            ? 'Replace Rate Guide'
            : 'Upload Rate Guide'
          %>

          <input
            type="file"
            name="rateGuideImage"
            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
            required
          >

          <small>
            JPEG, PNG or WebP only.
            Maximum file size: 5 MB.
          </small>

        </label>


        <button
          type="submit"
          class="btn-primary"
        >
          <%= rateGuide
            ? 'Replace Rate Guide'
            : 'Upload Rate Guide'
          %>
        </button>

      </form>

    </div>

  </section>

</body>

</html>