<%- include('partials/header') %>

<section
  style="
    background:#f5f7fa;
    padding:90px 20px;
    min-height:520px;
    display:flex;
    align-items:center;
    justify-content:center;
  "
>
  <div
    style="
      width:100%;
      max-width:560px;
      background:#ffffff;
      border-radius:12px;
      border-top:4px solid #033669;
      box-shadow:0 12px 35px rgba(3,54,105,0.10);
      padding:42px 34px;
      text-align:center;
    "
  >

    <div
      style="
        width:64px;
        height:64px;
        margin:0 auto 24px auto;
        border-radius:50%;
        background:#fff3ea;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:30px;
        color:#f68634;
      "
    >
      ✉
    </div>

    <p
      style="
        margin:0 0 12px 0;
        font-size:12px;
        color:#f68634;
        font-weight:700;
        letter-spacing:1.8px;
        text-transform:uppercase;
      "
    >
      Newsletter Preferences
    </p>

    <h1
      style="
        margin:0 0 18px 0;
        color:#033669;
        font-size:30px;
        line-height:1.25;
      "
    >
      Unsubscribe from our newsletter?
    </h1>

    <p
      style="
        margin:0 auto 28px auto;
        max-width:440px;
        color:#5f6b7a;
        font-size:16px;
        line-height:1.7;
      "
    >
      We're sorry to see you go. Once you unsubscribe,
      you will no longer receive newsletter updates and
      marketing communications from STI Assets Management.
    </p>


    <% if (errorMessage) { %>

      <div
        style="
          margin:0 0 24px 0;
          padding:14px 16px;
          background:#fff4f4;
          border:1px solid #f3cccc;
          border-radius:7px;
          color:#9b2c2c;
          font-size:14px;
          line-height:1.5;
        "
      >
        <%= errorMessage %>
      </div>

    <% } %>


    <form
      method="post"
      action="<%= unsubscribePath %>"
      style="margin:0;"
    >

      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <button
        type="submit"
        style="
          border:0;
          border-radius:7px;
          background:#f68634;
          color:#ffffff;
          padding:14px 34px;
          font-size:15px;
          font-weight:700;
          cursor:pointer;
        "
      >
        Unsubscribe
      </button>

    </form>


    <p
      style="
        margin:22px 0 0 0;
        font-size:14px;
        color:#718096;
      "
    >
      Changed your mind?
      <a
        href="/"
        style="
          color:#033669;
          font-weight:700;
          text-decoration:none;
        "
      >
        Return to our website
      </a>
    </p>

  </div>
</section>

<%- include('partials/footer') %>