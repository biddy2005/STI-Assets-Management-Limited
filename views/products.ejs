<%- include('partials/header', {
  pageCss: '/css/pages/products.css'
}) %>

<!-- ============================================================
     SECTION 1: HERO BANNER
============================================================ -->
<section class="inner-page-hero products-page-hero">
  <div class="inner-page-hero-inner">
    <span class="hero-eyebrow">Our Products</span>
    <h1>Investment Products Built Around You</h1>
    <p>Explore a range of money market and fixed income solutions designed to preserve capital and grow wealth.</p>
  </div>
</section>

<!-- ============================================================
     SECTION 2: PRODUCT 01: STIAM MONEY MARKET NOTE
============================================================ -->
<section
  id="money-market-note"
  class="section product-block product-block-white product-section product-money-market-section"
>
  <div class="money-market-showcase">

    <header class="money-market-overview">

      <div class="money-market-copy">

        <div class="product-section-index">
          <span class="product-section-number">01</span>
        </div>

        <h2>STIAM Money Market Note (SMM)</h2>

        <p>
          Short-term investment vehicle designed to deliver capital preservation and consistent wealth appreciation by allocating funds to specific financial instruments. Targeting risk-averse investors looking for superior returns compared to standard savings accounts, SMM mandates a minimum 90-day holding period.
        </p>

      </div>

      <div
        class="money-market-facts"
        aria-label="STIAM Money Market Note investment terms"
      >

        <div class="money-market-fact">
          <span class="money-market-fact-label">
            Minimum Initial Investment:
          </span>

          <strong class="money-market-fact-value">
            ₦250,000
          </strong>
        </div>

        <div class="money-market-fact">
          <span class="money-market-fact-label">
            Tenor:
          </span>

          <strong class="money-market-fact-value">
            90 days to a maximum period of 1 year
          </strong>
        </div>

      </div>

    </header>

    <div class="money-market-detail-grid">

      <figure class="money-market-image">
        <img
          src="/moneymarket.jpg"
          alt="Stacked coins representing money market investment growth"
          loading="lazy"
          decoding="async"
        >
      </figure>

      <aside
        class="money-market-benefits"
        aria-label="STIAM Money Market Note key benefits"
      >

        <header class="money-market-benefits-header">

          <h3>Key Benefits</h3>

          <p class="money-market-risk">
            <span>Risk Level:</span>
            <strong>Low</strong>
          </p>

        </header>

        <div class="money-market-benefit-grid">

          <article class="money-market-benefit">

            <span
              class="money-market-benefit-icon"
              aria-hidden="true"
            >
              <svg
                class="ui-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
              >
                <circle
                  cx="12"
                  cy="12"
                  r="9"
                ></circle>

                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </span>

            <div class="money-market-benefit-copy">
              <h4>Professional fund management</h4>

              <p>
                Expertly managed by seasoned professionals to optimize returns and manage risk.
              </p>
