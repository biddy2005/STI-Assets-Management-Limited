<!-- ============================================================
     SECTION 5: WEEKLY RATE GUIDE
============================================================ -->
<section
  class="section product-block product-block-light product-rate-section"
>
  <div class="rate-guide-showcase">

    <header class="rate-guide-header">
      <h2>Rate Guide</h2>
    </header>

    <div class="rate-guide-layout">

      <figure class="rate-guide-visual">

        <div
          class="rate-guide-table-scroll"
          tabindex="0"
          role="region"
          aria-label="Scrollable weekly rate guide"
        >
          <img
            src="<%= rateGuideImageUrl %>"
            alt="Weekly rate guide data table"
            loading="lazy"
            decoding="async"
          >
        </div>

      </figure>

      <aside
        class="rate-guide-notes"
        aria-labelledby="rate-guide-notes-title"
      >

        <h3
          id="rate-guide-notes-title"
          class="rate-guide-notes-title"
        >
          Note:
        </h3>

        <ul class="rate-guide-notes-list">

          <li>
            The interest rate is subject to adjustment in accordance with prevailing money market conditions.
          </li>

          <li>
            We are open to further rate negotiations for higher investment volumes, specifically from ₦100 million and above.
          </li>

        </ul>

      </aside>

    </div>

  </div>
