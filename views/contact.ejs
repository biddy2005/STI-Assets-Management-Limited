<%- include('partials/header', {
    pageCss: '/css/pages/contact.css?v=2'
}) %>

<!-- ============================================================
     CONTACT HERO
============================================================ -->
<section class="page-hero" aria-labelledby="contact-hero-title">

  <div class="page-hero-media" aria-hidden="true">
    <img
      src="/hero-poster.webp"
      alt=""
      fetchpriority="high"
      decoding="async"
    >
  </div>

  <div class="page-hero-overlay" aria-hidden="true"></div>

  <div class="page-shell page-hero-inner">

    <div class="page-hero-copy">

      <nav class="page-breadcrumb page-enter" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Contact</span>
      </nav>

      <h1
        id="contact-hero-title"
        class="page-hero-title page-enter"
        style="--page-enter-delay: 120ms"
      >
        Let's have a conversation.
      </h1>

      <p
        class="page-hero-summary page-enter"
        style="--page-enter-delay: 240ms"
      >
        Reach out and a member of our team will come back to you within one
        business day.
      </p>

    </div>

  </div>

</section>

<!-- ============================================================
     CONTACT DETAILS AND FORM
============================================================ -->
<section class="contact-section">

  <div class="contact-shell">

    <% if (
      typeof success !== 'undefined' &&
      success
    ) { %>

      <div
        class="contact-success-banner"
        role="status"
      >

        <svg
          class="ui-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="m8.5 12 2.3 2.3 4.7-4.8"></path>
        </svg>

        <p>
          Your message was sent successfully. We'll be in touch soon.
        </p>

      </div>

    <% } %>


    <div class="contact-layout">

      <!-- ========================================================
           CONTACT INFORMATION
      ========================================================= -->
      <div class="contact-info-column">


        <!-- Address -->
        <article class="contact-info-item">

          <span
            class="contact-info-icon"
            aria-hidden="true"
          >

            <svg
              class="ui-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
            >
              <path
                d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"
              ></path>

              <circle
                cx="12"
                cy="10"
                r="2.5"
              ></circle>
            </svg>

          </span>

          <div class="contact-info-copy">

            <h3>
              Address
            </h3>

            <p>
              Plot 169b Moshood Olugbani Street, Victoria Island, Lagos.
            </p>

          </div>

        </article>


        <!-- Email -->
        <article class="contact-info-item">

          <span
            class="contact-info-icon"
            aria-hidden="true"
          >

            <svg
              class="ui-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
            >
              <rect
                x="3"
                y="5"
                width="18"
                height="14"
                rx="2"
              ></rect>

              <path d="m4 7 8 6 8-6"></path>
            </svg>

          </span>

          <div class="contact-info-copy">

            <h3>
              Email address
            </h3>

            <p>
              <a href="mailto:info@stiassetmgt.com">
                info@stiassetmgt.com
              </a>

              <a href="mailto:investment@stiassetmgt.com">
                investment@stiassetmgt.com
              </a>
            </p>

          </div>

        </article>


        <!-- Phone -->
        <article class="contact-info-item">

          <span
            class="contact-info-icon"
            aria-hidden="true"
          >

            <svg
              class="ui-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
            >
              <path
                d="M8.2 3.5 10 7.8 7.8 9.4a15 15 0 0 0 6.8 6.8l1.6-2.2 4.3 1.8v3a2 2 0 0 1-2.1 2A17.4 17.4 0 0 1 3.2 5.6a2 2 0 0 1 2-2.1Z"
              ></path>
            </svg>

          </span>

          <div class="contact-info-copy">

            <h3>
              Phone number
            </h3>

            <p>
              <a href="tel:09165439544">
                09165439544
              </a>

              <span
                class="contact-phone-separator"
                aria-hidden="true"
              >
                |
              </span>

              <a href="tel:08033230987">
                08033230987
              </a>
            </p>

          </div>

        </article>


        <!-- Social -->
        <article class="contact-info-item contact-info-social">

          <span
            class="contact-info-icon"
            aria-hidden="true"
          >

            <svg
              class="ui-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
            >
              <circle
                cx="12"
                cy="12"
                r="9"
              ></circle>

              <path d="M3 12h18"></path>

              <path
                d="M12 3a15 15 0 0 1 0 18"
              ></path>

              <path
                d="M12 3a15 15 0 0 0 0 18"
              ></path>
            </svg>

          </span>

          <div class="contact-info-copy">

            <h3>
              Follow us on social media
            </h3>

            <div class="contact-social-row">

              <a
                href="#"
                class="contact-social-link"
                aria-label="Facebook"
              >
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path
                    d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3"
                  ></path>
                </svg>
              </a>


              <a
                href="#"
                class="contact-social-link"
                aria-label="Instagram"
              >
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect
                    x="3"
                    y="3"
                    width="18"
                    height="18"
                    rx="5"
                  ></rect>

                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                  ></circle>

                  <circle
                    cx="17.5"
                    cy="6.5"
                    r="0.6"
                    fill="currentColor"
                    stroke="none"
                  ></circle>
                </svg>
              </a>


              <a
                href="#"
                class="contact-social-link"
                aria-label="LinkedIn"
              >
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect
                    x="3"
                    y="9"
                    width="4"
                    height="12"
                  ></rect>

                  <circle
                    cx="5"
                    cy="5"
                    r="2"
                  ></circle>

                  <path d="M11 9v12"></path>

                  <path
                    d="M11 14a4 4 0 0 1 8 0v7"
                  ></path>
                </svg>
              </a>


              <a
                href="#"
                class="contact-social-link"
                aria-label="Twitter"
              >
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path
                    d="M22 4s-.7 2.1-2 3.4c1.6 9.4-9.4 16.6-17 11.6 2.9.1 5.8-.8 8-2.6-2.7-.1-5-1.9-5.8-4.4.9.2 1.8.1 2.6-.1C4.8 11.4 3 9.1 3 6.4c.8.5 1.7.8 2.6.8C3.9 5.9 3.1 3.2 4.5 1.2 7.2 4.5 11.2 6.6 15.6 6.8c-.7-3 1.6-5.8 4.7-5.8"
                  ></path>
                </svg>
              </a>

            </div>

          </div>

        </article>

      </div>


      <!-- ========================================================
           CONTACT FORM
      ========================================================= -->
      <div class="contact-form-column">

        <div class="contact-form-card">

          <% if (
            typeof error !== 'undefined' &&
            error
          ) { %>

            <p
              class="form-error"
              role="alert"
            >
              <%= error %>
            </p>

          <% } %>


          <form
            action="/api/contact"
            method="POST"
            class="contact-form"
          >

            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >


            <label
              class="honeypot"
              aria-hidden="true"
            >
              Website

              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              >
            </label>


            <div class="contact-form-row">

              <label>
                First Name

                <input
                  type="text"
                  name="firstName"
                  autocomplete="given-name"
                  required
                >
              </label>


              <label>
                Last Name

                <input
                  type="text"
                  name="lastName"
                  autocomplete="family-name"
                  required
                >
              </label>

            </div>


            <label>
              Email

              <input
                type="email"
                name="email"
                autocomplete="email"
                required
              >
            </label>


            <label>
              Phone number

              <input
                type="tel"
                name="phone"
                autocomplete="tel"
              >
            </label>


            <label>
              Message

              <textarea
                name="message"
                rows="5"
                required
              ></textarea>
            </label>


            <button
              type="submit"
              class="contact-submit"
            >
              <span>
                Send Message
              </span>
            </button>

          </form>

        </div>

      </div>

    </div>

  </div>

</section>

<!-- ============================================================
     LOCATION MAP
============================================================ -->
<section class="contact-map-section">

  <div class="contact-map-shell">

    <header class="contact-map-header">
      <p class="page-eyebrow">Location</p>
      <h2 class="page-title-sm">Victoria Island, Lagos.</h2>
      <p class="page-lead">
        Plot 169b Moshood Olugbani Street. Visitors are welcome Monday to
        Friday, 8:00am to 5:00pm.
      </p>
    </header>


    <div class="contact-map-frame">

      <iframe
        src="https://www.google.com/maps?q=Plot+169b+Moshood+Olugbani+Street,+Victoria+Island,+Lagos&output=embed"
        title="STI Assets Management office location"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>

    </div>

  </div>

</section>

<%- include('partials/footer') %>