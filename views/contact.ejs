<%- include('partials/header') %>

<section class="inner-page-hero digest-hero">
  <div class="inner-page-hero-inner">
    <span class="hero-eyebrow">Get In Touch</span>
    <h1>Let's Have A Conversation</h1>
    <p>We'd love to hear from you. Reach out and our team will get back to you shortly.</p>
  </div>
</section>

<section class="section contact-section">
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="contact-success-banner">
      <p>Your message was sent successfully. We'll be in touch soon.</p>
    </div>
  <% } %>
  <div class="contact-split">
    <div class="contact-info-column">
      <div class="contact-info-item">
        <div class="contact-info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#033669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div>
          <h3>Address</h3>
          <p>Plot 169b Moshood Olugbani Street, Victoria Island, Lagos.</p>
        </div>
      </div>

      <div class="contact-info-item">
        <div class="contact-info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#033669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M2 7l10 6 10-6"></path>
          </svg>
        </div>
        <div>
          <h3>Email Address</h3>
          <p><a href="mailto:info@stiassetmgt.com">info@stiassetmgt.com</a><br><a href="mailto:investment@stiassetmgt.com">investment@stiassetmgt.com</a></p>
        </div>
      </div>

      <div class="contact-info-item">
        <div class="contact-info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#033669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div>
          <h3>Phone Number</h3>
          <p><a href="tel:09165439544">09165439544</a> and <a href="tel:08033230987">08033230987</a></p>
        </div>
      </div>

      <div class="contact-info-item">
        <div class="contact-info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#033669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18"></path>
            <path d="M12 3a15 15 0 0 1 0 18"></path>
            <path d="M12 3a15 15 0 0 0 0 18"></path>
          </svg>
        </div>
        <div>
          <h3>Follow Us on Social Media</h3>
          <div class="contact-social-row">
            <a href="#" class="social-icon" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" stroke="#033669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
            <a href="#" class="social-icon" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="#033669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="0.6" fill="#033669"></circle>
              </svg>
            </a>
            <a href="#" class="social-icon" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="#033669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
                <path d="M10 9v12"></path>
                <path d="M10 13a4 4 0 0 1 8 0v8"></path>
              </svg>
            </a>
            <a href="#" class="social-icon" aria-label="Twitter">
              <svg viewBox="0 0 24 24" fill="none" stroke="#033669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 4s-.7 2.1-2 3.4c1.6 9.4-9.4 16.6-17 11.6 2.9.1 5.8-.8 8-2.6-2.7-.1-5-1.9-5.8-4.4.9.2 1.8.1 2.6-.1C4.8 11.4 3 9.1 3 6.4c.8.5 1.7.8 2.6.8C3.9 5.9 3.1 3.2 4.5 1.2 7.2 4.5 11.2 6.6 15.6 6.8c-.7-3 1.6-5.8 4.7-5.8 1.4 0 2.6.6 3.5 1.5 1.1-.2 2.1-.6 3-1.2-.4 1.1-1.1 2.1-2.1 2.7.9-.1 1.8-.3 2.6-.7-.6.9-1.4 1.7-2.3 2.3z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="contact-form-column">
      <div class="contact-form-card">
        <% if (typeof error !== 'undefined' && error) { %><p class="form-error"><%= error %></p><% } %>
        <form action="/api/contact" method="POST" class="contact-form">
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >
          <label class="honeypot" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>

          <div class="contact-form-row">
            <label>First Name
              <input type="text" name="firstName" required>
            </label>
            <label>Last Name
              <input type="text" name="lastName" required>
            </label>
          </div>
          <label>Email
            <input type="email" name="email" required>
          </label>
          <label>Phone Number
            <input type="tel" name="phone">
          </label>
          <label>Message
            <textarea name="message" rows="5" required></textarea>
          </label>
          <button type="submit" class="btn-primary">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="section contact-map-section">
  <h2>Find Us Here!</h2>
  <div class="contact-map-wrapper">
    <iframe
      src="https://www.google.com/maps?q=Plot+169b+Moshood+Olugbani+Street,+Victoria+Island,+Lagos&output=embed"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade">
    </iframe>
  </div>
</section>

<%- include('partials/footer') %>