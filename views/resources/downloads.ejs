<%- include('../partials/header', {
  pageCss: '/css/pages/downloads.css?v=2'
}) %>

<section class="page-hero" aria-labelledby="downloads-hero-title">

  <div class="page-hero-media" aria-hidden="true">
    <img
      src="/faqs-hero.webp"
      alt=""
      fetchpriority="high"
      decoding="async"
    >
  </div>

  <div class="page-hero-overlay" aria-hidden="true"></div>

  <div class="page-shell page-hero-inner">
    <div class="page-hero-copy">

      <nav class="page-breadcrumb page-enter" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/resources">Resources</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Daily digest</span>
      </nav>

      <h1
        id="downloads-hero-title"
        class="page-hero-title page-enter"
        style="--page-enter-delay: 120ms"
      >
        Daily market digest.
      </h1>

      <p
        class="page-hero-summary page-enter"
        style="--page-enter-delay: 240ms"
      >
        A daily read on Nigerian markets from our research team, covering
        equities, fixed income, earnings and the economic indicators that move
        them.
      </p>

    </div>
  </div>
</section>

<!-- ============================================================
     THIS WEEK'S DIGESTS
============================================================ -->
<section class="section downloads-section">

  <div class="downloads-shell">

    <div class="downloads-grid">

      <% weekDigests.forEach(function (day) { %>

        <article
          class="downloads-card <%= day.digest ? 'is-available' : 'is-unavailable' %>"
        >

          <div class="downloads-card-header">

            <span class="downloads-day">
              <%= day.label %>
            </span>

          </div>

          <% if (day.digest) { %>

            <div class="downloads-card-content">

              <span
                class="downloads-icon-frame"
                aria-hidden="true"
              >
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <path d="M12 3v11"></path>
                  <path d="m8 10 4 4 4-4"></path>
                  <path d="M5 18v2h14v-2"></path>
                </svg>
              </span>

              <div class="downloads-card-copy">

                <h3>
                  <%= day.digest.title %>
                </h3>

                <p>
                  <%= day.formattedDate %>
                </p>

              </div>

            </div>

            <a
              class="downloads-btn"
              href="<%= day.digest.filePath %>"
              download
              target="_blank"
              rel="noopener"
            >
              <span>Download PDF</span>

              <svg
                class="ui-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>

          <% } else { %>

            <div class="downloads-card-content">

              <span
                class="downloads-icon-frame downloads-icon-frame-muted"
                aria-hidden="true"
              >
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                  ></circle>

                  <path d="M12 7v5l3 2"></path>
                </svg>
              </span>

              <div class="downloads-card-copy">

                <p>
                  <%= day.formattedDate %>
                </p>

              </div>

            </div>

            <span
              class="downloads-btn downloads-btn-disabled"
              aria-disabled="true"
            >
              Digest unavailable
            </span>

          <% } %>

        </article>

      <% }); %>

    </div>

  </div>

</section>

<%- include('../partials/footer') %>