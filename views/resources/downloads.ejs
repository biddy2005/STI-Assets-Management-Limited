<%- include('../partials/header', {
  pageCss: '/css/pages/downloads.css'
}) %>

<section class="inner-page-hero downloads-page-hero">
  <div class="inner-page-hero-inner">
    <span class="hero-eyebrow">Resources</span>
    <h1>STIAM Daily Market Digest</h1>
    <p>Introducing the STIAM Daily Market Digest, your ultimate guide to navigating the world of business and finance! Our team of expert analysts has scoured the markets to bring you the most relevant and up-to-date news and insights on a daily basis. From stock market updates and earnings reports to industry trends and economic indicators, the STIAM Daily Market Digest has got you covered.</p>
  </div>
</section>

<!-- ============================================================
     THIS WEEK'S DIGESTS
============================================================ -->
<section class="section downloads-section">

  <div class="downloads-shell">

    <div class="downloads-grid">

      <% weekDigests.forEach(function (day) { %>

        <article
          class="downloads-card <%= day.digest ? 'is-available' : 'is-unavailable' %>"
        >

          <div class="downloads-card-header">

            <span class="downloads-day">
              <%= day.label %>
            </span>

          </div>

          <% if (day.digest) { %>

            <div class="downloads-card-content">

              <span
                class="downloads-icon-frame"
                aria-hidden="true"
              >
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <path d="M12 3v11"></path>
                  <path d="m8 10 4 4 4-4"></path>
                  <path d="M5 18v2h14v-2"></path>
                </svg>
              </span>

              <div class="downloads-card-copy">

                <h3>
                  <%= day.digest.title %>
                </h3>

                <p>
                  <%= day.formattedDate %>
                </p>

              </div>

            </div>

            <a
              class="downloads-btn"
              href="<%= day.digest.filePath %>"
              download
              target="_blank"
              rel="noopener"
            >
              <span>Download PDF</span>

              <svg
                class="ui-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>

          <% } else { %>

            <div class="downloads-card-content">

              <span
                class="downloads-icon-frame downloads-icon-frame-muted"
                aria-hidden="true"
              >
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                  ></circle>

                  <path d="M12 7v5l3 2"></path>
                </svg>
              </span>

              <div class="downloads-card-copy">

                <p>
                  <%= day.formattedDate %>
                </p>

              </div>

            </div>

            <span
              class="downloads-btn downloads-btn-disabled"
              aria-disabled="true"
            >
              Digest unavailable
            </span>

          <% } %>

        </article>

      <% }); %>

    </div>

  </div>

</section>

<%- include('../partials/footer') %>