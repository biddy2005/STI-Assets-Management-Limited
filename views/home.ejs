<!-- ============================================================
     4. STI IN NUMBERS
============================================================ -->
<section
  class="home-proof"
  aria-label="STI Assets Management key statistics"
>
  <div class="home-shell home-proof-grid">

    <div class="home-proof-item" data-reveal="up">
      <strong class="home-proof-value">
        <span
          class="counter"
          data-target="20"
          data-prefix="₦"
          data-suffix="B+"
        >₦20B+</span>
      </strong>

      <span class="home-proof-label">
        Assets Under Management
      </span>
    </div>


    <div class="home-proof-item" data-reveal="up">
      <strong class="home-proof-value">
        <span
          class="counter"
          data-target="100"
          data-suffix="+"
        >100+</span>
      </strong>

      <span class="home-proof-label">
        Clients Served
      </span>
    </div>


    <div class="home-proof-item" data-reveal="up">
      <strong class="home-proof-value">
        <span
          class="counter"
          data-target="<%= new Date().getFullYear() - 2008 %>"
          data-suffix="+"
        ><%= new Date().getFullYear() - 2008 %>+</span>
      </strong>

      <span class="home-proof-label">
        Years in Operation
      </span>
    </div>


    <div class="home-proof-item" data-reveal="up">
      <strong class="home-proof-value">
        <span
          class="counter"
          data-target="25"
          data-suffix="+"
        >25+</span>
      </strong>

      <span class="home-proof-label">
        Investment Professionals
      </span>
    </div>

  </div>
</section>


