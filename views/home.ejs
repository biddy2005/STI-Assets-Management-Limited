<%- include('partials/header', {
  pageCss: '/css/pages/home.css'
}) %>

<!-- ============================================================
     1. HERO SECTION
============================================================ -->
<section class="hero-v2">

  <div class="hero-v2-inner">

    <div class="hero-v2-content">

      <div class="hero-v2-kicker">
        <span>
          Investment Management &bull; Financial Advisory
        </span>
      </div>


      <!-- Rotating Hero Message -->
      <div
        class="hero-message-stage"
        data-hero-rotator
        role="group"
        aria-label="STI Assets Management introduction"
        aria-live="off"
      >

        <!-- Message 1 -->
        <h1
          class="hero-message hero-v2-heading is-active"
          data-duration="2500"
          aria-hidden="false"
        >
          <span
            class="hero-word"
            style="--word-index: 0"
          >
            Simplified
          </span>

          <span
            class="hero-word"
            style="--word-index: 1"
          >
            Finance
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 2"
          >
            Management
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 3"
          >
            Services
          </span>
        </h1>


        <!-- Message 2 -->
        <p
          class="hero-message hero-message-support"
          data-duration="2400"
          aria-hidden="true"
        >
          <span class="hero-word" style="--word-index: 0">
            Serving
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 1"
          >
            Individuals
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 2"
          >
            &amp;
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 3"
          >
            Institutions
          </span>
        </p>


        <!-- Message 3 -->
        <p
          class="hero-message hero-message-support"
          data-duration="2600"
          aria-hidden="true"
        >
          <span class="hero-word" style="--word-index: 0">
            Delivering
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 1"
          >
            Superior
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 2"
          >
            Investment
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 3"
          >
            Outcomes
          </span>
        </p>


        <!-- Message 4 / CTA -->
        <a
          href="/contact"
          class="hero-message hero-message-cta"
          data-duration="3200"
          aria-hidden="true"
          tabindex="-1"
          aria-label="Get started with STI Assets Management"
        >
          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 0"
          >
            Get
          </span>

          <span
            class="hero-word hero-word-highlight"
            style="--word-index: 1"
          >
            started
          </span>

          <span class="hero-word" style="--word-index: 2">
            with
          </span>

          <span class="hero-word" style="--word-index: 3">
            us
          </span>

          <span class="hero-word" style="--word-index: 4">
            now
          </span>

          <span
            class="hero-word hero-cta-arrow"
            style="--word-index: 5"
            aria-hidden="true"
          >
            →
          </span>
        </a>

      </div>


      <!-- Trust Highlights -->
      <div
        class="hero-trust-bar"
        aria-label="Why clients choose STI Assets Management"
      >
        <span class="hero-trust-item">
          SEC Regulated
        </span>

        <span
          class="hero-trust-divider"
          aria-hidden="true"
        >
          |
        </span>

        <span class="hero-trust-item">
          Professional Fund Managers
        </span>
      </div>

    </div>

  </div>

</section>

<div
  class="hero-v2-stats"
  role="list"
  aria-label="STI Assets Management key statistics"
>
  <div class="hero-v2-stats-col" role="listitem">
    <span class="hero-v2-stats-icon" aria-hidden="true">
      <i
        data-lucide="landmark"
        class="ui-icon ui-icon-md"
        aria-hidden="true"
      ></i>
    </span>
    <div class="hero-v2-stats-number"><span class="counter" data-target="250" data-prefix="₦" data-suffix="B+">0</span></div>
    <div class="hero-v2-stats-label">Assets Under Management</div>
  </div>
  <div class="hero-v2-stats-col" role="listitem">
    <span class="hero-v2-stats-icon" aria-hidden="true">
      <i
        data-lucide="users"
        class="ui-icon ui-icon-md"
        aria-hidden="true"
      ></i>
    </span>
    <div class="hero-v2-stats-number"><span class="counter" data-target="1500" data-suffix="+">0</span></div>
    <div class="hero-v2-stats-label">Happy Clients</div>
  </div>
  <div class="hero-v2-stats-col" role="listitem">
    <span class="hero-v2-stats-icon" aria-hidden="true">
      <i
        data-lucide="user-check"
        class="ui-icon ui-icon-md"
        aria-hidden="true"
      ></i>
    </span>
    <div class="hero-v2-stats-number"><span class="counter" data-target="25" data-suffix="+">0</span></div>
    <div class="hero-v2-stats-label">Investment Professionals</div>
  </div>
  <div class="hero-v2-stats-col" role="listitem">
    <span class="hero-v2-stats-icon" aria-hidden="true">
      <i
        data-lucide="calendar-days"
        class="ui-icon ui-icon-md"
        aria-hidden="true"
      ></i>
    </span>
    <div class="hero-v2-stats-number"><span class="counter" data-target="18">0</span></div>
    <div class="hero-v2-stats-label">Years in Business</div>
  </div>
</div>

  
