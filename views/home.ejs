<!-- ============================================================
     6. COMMUNITY / INSIGHTS SECTION
     Featured news carousel
============================================================ -->
<section class="home-insights-section" id="insights">
  <div class="home-insights-decor home-insights-decor-tl" aria-hidden="true"></div>
  <div class="home-insights-decor home-insights-decor-tr" aria-hidden="true"></div>
  <div class="home-insights-decor home-insights-decor-curve" aria-hidden="true"></div>

  <div class="home-insights-container">

    <div class="services-modern-header home-insights-header">
      <div class="values-eyebrow-row">
        <span class="values-eyebrow-line"></span>
        <span class="eyebrow">Community &amp; Insights</span>
        <span class="values-eyebrow-line"></span>
      </div>
      <h2 class="services-modern-heading">Latest Updates From Our Community</h2>
      <p class="services-modern-subheading home-insights-subheading">
        Stay informed with our latest news, market insights, and perspectives from our team of investment experts.
      </p>
    </div>

    <% if (!articles || articles.length === 0) { %>
      <div class="home-insights-empty">
        <p>No updates are available at the moment. Please check back soon.</p>
      </div>
    <% } else { %>
      <div class="home-insights-carousel"
           data-home-insights-carousel
           aria-roledescription="carousel"
           aria-label="Community and Insights articles">

        <% if (articles.length > 1) { %>
        <button type="button" class="home-insights-arrow home-insights-arrow-prev" data-home-insights-prev aria-label="Previous article">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <% } %>

        <div class="home-insights-viewport">
          <div class="home-insights-track" data-home-insights-track>
            <% articles.forEach(function (article, index) { %>
              <div class="home-insights-slide"
                   role="group"
                   aria-roledescription="slide"
                   aria-label="<%= index + 1 %> of <%= articles.length %>"
                   aria-hidden="<%= index === 0 ? 'false' : 'true' %>"
                   data-home-insights-slide>
                <article class="home-insights-card">
                  <div class="home-insights-image-wrap">
                    <img
                      class="home-insights-image"
                      src="<%= (article.coverImage && article.coverImage.trim() !== '') ? article.coverImage : 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80' %>"
                      alt="<%= article.title %>"
                      loading="lazy"
                    >
                  </div>
                  <div class="home-insights-content">
                    <span class="home-insights-category"><%= (article.category || 'INSIGHTS').toUpperCase() %></span>
                    <% if (article.date) { %>
                    <span class="home-insights-date">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 10h17"/><path d="M8 3v4M16 3v4"/></svg>
                      <%= article.date %>
                    </span>
                    <% } %>
                    <h3 class="home-insights-title"><%= article.title %></h3>
                    <p class="home-insights-excerpt"><%= article.excerpt %></p>
                    <a href="/resources/news/<%= article.slug %>" class="home-insights-link" tabindex="<%= index === 0 ? '0' : '-1' %>">
                      <span class="home-insights-link-text">Read Article</span>
                      <svg class="home-insights-link-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                  </div>
                </article>
              </div>
            <% }); %>
          </div>
        </div>

        <% if (articles.length > 1) { %>
        <button type="button" class="home-insights-arrow home-insights-arrow-next" data-home-insights-next aria-label="Next article">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        <div class="home-insights-controls" data-home-insights-dots>
          <% articles.forEach(function (article, index) { %>
            <button type="button" class="home-insights-dot<%= index === 0 ? ' is-active' : '' %>" data-home-insights-dot data-index="<%= index %>" aria-label="Go to article <%= index + 1 %>"></button>
          <% }); %>
        </div>
        <% } %>
      </div>
    <% } %>

  </div>
</section>

