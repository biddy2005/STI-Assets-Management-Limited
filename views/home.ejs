<!-- ============================================================
     8. NEWS
     Dynamic news data retained from the current Express/EJS implementation.
============================================================ -->
<section
  class="home-insights"
  id="insights"
  aria-labelledby="home-insights-title"
>
  <div class="home-shell">
    <div class="home-section-intro" data-reveal="up">
      <div>
        <p class="home-section-label">News &amp; Updates</p>
        <h2 id="home-insights-title">
          The latest from STI.
        </h2>
      </div>

      <div class="home-section-intro-side">

        <a href="/resources/news" class="home-text-link">
          <span>View all news</span>
          <i
            data-lucide="arrow-up-right"
            class="ui-icon ui-icon-sm"
            aria-hidden="true"
          ></i>
        </a>
      </div>
    </div>

    <% if (homeArticles.length === 0) { %>
      <div class="home-insights-empty" data-reveal="up">
        <div>
          <span class="home-insights-empty-icon" aria-hidden="true">
            <i data-lucide="newspaper" class="ui-icon ui-icon-md"></i>
          </span>
          <h3>No updates available yet</h3>
          <p>
            New company news and updates will appear here when
            they are published.
          </p>
        </div>
      </div>
    <% } else { %>
      <div
        class="home-insights-grid home-insights-grid-<%= homeArticles.length %>"
      >
        <% homeArticles.forEach(function (article, index) { %>
          <article
            class="home-insight-card <%= index === 0 ? 'home-insight-card-featured' : '' %>"
            data-reveal="up"
          >
            <a
              href="/resources/news/<%= article.slug %>"
              class="home-insight-image-link"
              aria-label="Read article: <%= article.title || 'STI Assets Management Update' %>"
            >
              <img
                src="<%= (
                  article.coverImage &&
                  String(article.coverImage).trim() !== ''
                )
                  ? article.coverImage
                  : '/stilogo.png'
                %>"
                alt="<%= article.title || 'STI Assets Management update' %>"
                loading="lazy"
                decoding="async"
              >
            </a>

            <div class="home-insight-copy">
              <div class="home-insight-meta">
                <span><%= String(article.category || 'News').toUpperCase() %></span>
                <% if (article.date) { %>
                  <time><%= article.date %></time>
                <% } %>
              </div>

              <h3>
                <a href="/resources/news/<%= article.slug %>">
                  <%= article.title || 'STI Assets Management Update' %>
                </a>
              </h3>

              <p>
                <%= article.excerpt || 'Read the latest news from STI Assets Management.' %>
              </p>

              <a
                href="/resources/news/<%= article.slug %>"
                class="home-text-link"
              >
                <span>Read article</span>
                <i
                  data-lucide="arrow-right"
                  class="ui-icon ui-icon-sm"
                  aria-hidden="true"
                ></i>
              </a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

