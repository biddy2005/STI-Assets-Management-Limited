<!-- ============================================================
     5. COMMUNITY & INSIGHTS
     Featured news carousel
============================================================ -->
<section
  class="home-insights-section"
  id="insights"
  aria-labelledby="home-insights-heading"
>
  <div
    class="home-insights-decor home-insights-decor-tl"
    aria-hidden="true"
  ></div>

  <div
    class="home-insights-decor home-insights-decor-tr"
    aria-hidden="true"
  ></div>

  <div
    class="home-insights-decor home-insights-decor-curve"
    aria-hidden="true"
  ></div>

  <div class="home-insights-container">

    <!-- Section heading -->
    <div class="services-modern-header home-insights-header">

      <div class="values-eyebrow-row">
        
        <span class="eyebrow">Community &amp; Insights</span>
        
      </div>

      <h2
        class="services-modern-heading"
        id="home-insights-heading"
      >
        Latest Updates From Our Community
      </h2>

      <p class="home-insights-subheading">
        Stay informed with company news, market insights and perspectives
        from our investment professionals.
      </p>

    </div>

    <% if (!articles || articles.length === 0) { %>

      <!-- Empty state -->
      <div class="home-insights-empty">

        <span
          class="home-insights-empty-icon"
          aria-hidden="true"
        >
          <i
            data-lucide="newspaper"
            class="ui-icon ui-icon-lg"
            aria-hidden="true"
          ></i>
        </span>

        <h3>No Updates Available</h3>

        <p>
          New company updates and market insights will appear here
          when they are published.
        </p>

      </div>

    <% } else { %>

      <!-- Carousel -->
      <div
        class="home-insights-carousel"
        data-home-insights-carousel
        aria-roledescription="carousel"
        aria-label="Community and Insights articles"
      >

        <% if (articles.length > 1) { %>

          <button
            type="button"
            class="home-insights-arrow home-insights-arrow-prev"
            data-home-insights-prev
            aria-label="Show previous article"
          >
            <i
              data-lucide="chevron-left"
              class="ui-icon"
              aria-hidden="true"
            ></i>
          </button>

        <% } %>

        <div class="home-insights-viewport">

          <div
            class="home-insights-track"
            data-home-insights-track
          >

            <% articles.forEach(function (article, index) { %>

              <div
                class="home-insights-slide"
                role="group"
                aria-roledescription="slide"
                aria-label="<%= index + 1 %> of <%= articles.length %>"
                aria-hidden="<%= index === 0 ? 'false' : 'true' %>"
                data-home-insights-slide
              >

                <article
                  class="home-insights-card"
                  aria-labelledby="home-insights-title-<%= index %>"
                  aria-describedby="home-insights-excerpt-<%= index %>"
                >

                  <div class="home-insights-image-wrap">
                    <img
                      class="home-insights-image"
                      src="<%= (
                        article.coverImage &&
                        String(article.coverImage).trim() !== ''
                      )
                        ? article.coverImage
                        : '/stilogo.png'
                      %>"
                      alt="<%= article.title || 'STI Assets Management update' %>"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>

                  <div class="home-insights-content">

                    <div class="home-insights-meta">

                      <span class="home-insights-category">
                        <%= String(article.category || 'Insights').toUpperCase() %>
                      </span>

                      <% if (article.date) { %>
                        <span class="home-insights-date">
                          <i
                            data-lucide="calendar-days"
                            class="ui-icon ui-icon-sm"
                            aria-hidden="true"
                          ></i>

                          <%= article.date %>
                        </span>
                      <% } %>

                    </div>

                    <h3
                      class="home-insights-title"
                      id="home-insights-title-<%= index %>"
                    >
                      <%= article.title || 'STI Assets Management Update' %>
                    </h3>

                    <p
                      class="home-insights-excerpt"
                      id="home-insights-excerpt-<%= index %>"
                    >
                      <%= article.excerpt || 'Read the latest update from STI Assets Management.' %>
                    </p>

                    <a
                      href="/resources/news/<%= article.slug %>"
                      class="home-insights-link"
                      tabindex="<%= index === 0 ? '0' : '-1' %>"
                      aria-label="Read article: <%= article.title || 'STI Assets Management Update' %>"
                    >
                      <span class="home-insights-link-text">Read Article</span>

                      <i
                        data-lucide="arrow-right"
                        class="home-insights-link-arrow ui-icon ui-icon-sm"
                        aria-hidden="true"
                      ></i>
                    </a>

                  </div>

                </article>

              </div>

            <% }); %>

          </div>

        </div>

        <% if (articles.length > 1) { %>

          <button
            type="button"
            class="home-insights-arrow home-insights-arrow-next"
            data-home-insights-next
            aria-label="Show next article"
          >
            <i
              data-lucide="chevron-right"
              class="ui-icon"
              aria-hidden="true"
            ></i>
          </button>

          <div
            class="home-insights-controls"
            data-home-insights-dots
            aria-label="Choose an article"
          >

            <% articles.forEach(function (article, index) { %>

              <button
                type="button"
                class="home-insights-dot<%= index === 0 ? ' is-active' : '' %>"
                data-home-insights-dot
                data-index="<%= index %>"
                aria-label="Go to article <%= index + 1 %>"
              ></button>

            <% }); %>

          </div>

        <% } %>

      </div>

    <% } %>

    <!-- View all news -->
    <div class="home-insights-footer">

      <a
        href="/resources/news"
        class="home-insights-view-all"
      >
        <span>View All News &amp; Insights</span>

      </a>

    </div>

  </div>
</section>
