# Rename this file to .env and fill in real values. Never commit .env to Git.

PORT=3000
NODE_ENV=development

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/asset_mgmt_db"

# Session secret - use a long random string in production
SESSION_SECRET="replace-with-a-long-random-string"

# Nodemailer (for contact form / job application email notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="admin@yourcompany.com"
