# Application
NODE_ENV="development"
PORT=3000
APP_BASE_URL="http://localhost:3000"
TRUST_PROXY=""
LOG_LEVEL="debug"

# PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/database"

# PostgreSQL runtime pool configuration.
#
# Values apply per Node.js application instance.
DB_POOL_MAX=10
SESSION_DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Sessions
SESSION_SECRET="replace-with-a-long-random-secret"

# Initial administrator
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"

# ============================================================
# STORAGE
# ============================================================

# Storage backend used by the application.
#
# Allowed values:
# local = development/test filesystem
# r2    = Cloudflare R2 object storage
STORAGE_DRIVER=local

# ============================================================
# CLOUDFLARE R2
# ============================================================
#
# Required only when STORAGE_DRIVER=r2.
#
# Do not place real credentials in this example file.

R2_ENDPOINT=

R2_ACCESS_KEY_ID=

R2_SECRET_ACCESS_KEY=

# Public website files:
# - News images
# - Daily Digest PDFs
# - Rate Guide images
R2_PUBLIC_BUCKET=

# Public HTTPS address used by browsers to retrieve public
# files from the public bucket.
R2_PUBLIC_BASE_URL=

# Private files:
# - Applicant résumés
R2_PRIVATE_BUCKET=

# ============================================================
# POWER AUTOMATE
# ============================================================
#
# Backend-only Microsoft Power Automate webhook URLs.
#
# Treat the complete callback URLs as secrets.
# Never commit real callback URLs.

POWER_AUTOMATE_CONTACT_URL=
POWER_AUTOMATE_CAREERS_URL=
POWER_AUTOMATE_NEWSLETTER_URL=
POWER_AUTOMATE_NEWSLETTER_UNSUBSCRIBE_URL=

# Newsletter unsubscribe signing
#
# Backend-only cryptographic secret used to sign newsletter
# unsubscribe links.
#
# Generate a strong random value and never commit it.
NEWSLETTER_UNSUBSCRIBE_SECRET=