# Application
NODE_ENV="development"
PORT=3000
APP_BASE_URL="http://localhost:3000"
TRUST_PROXY=""
LOG_LEVEL="debug"

# PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/database"

# Sessions
SESSION_SECRET="replace-with-a-long-random-secret"

# Initial administrator
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# ============================================================
# STORAGE
# ============================================================

# Storage backend used by the application.
#
# Allowed values:
# local = development/test filesystem
# r2    = Cloudflare R2 object storage
STORAGE_DRIVER=local

# ============================================================
# CLOUDFLARE R2
# ============================================================
#
# Required only when STORAGE_DRIVER=r2.
#
# Do not place real credentials in this example file.

R2_ENDPOINT=

R2_ACCESS_KEY_ID=

R2_SECRET_ACCESS_KEY=

# Public website files:
# - News images
# - Daily Digest PDFs
# - Rate Guide images
R2_PUBLIC_BUCKET=

# Public HTTPS address used by browsers to retrieve public
# files from the public bucket.
R2_PUBLIC_BASE_URL=

# Private files:
# - Applicant résumés
R2_PRIVATE_BUCKET=