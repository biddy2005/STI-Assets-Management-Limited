// Prisma schema for the Asset Management site
// Run `npm run prisma:migrate` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPERADMIN @map("superadmin")
  EDITOR     @map("editor")
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)

  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  sessionVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  auditLogs AuditLog[]

  @@index([isActive])
  @@index([lockedUntil])
  @@index([role, isActive])
}

model AuditLog {
  id Int @id @default(autoincrement())

  adminId Int?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  bio       String
  photoUrl  String?
  category  String // "board" | "management"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model NewsArticle {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  body        String
  coverImage  String?
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  images NewsImage[]
}

model NewsImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  newsArticleId Int
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)

  @@index([newsArticleId])
}

model Download {
  id         Int      @id @default(autoincrement())
  title      String
  fileUrl    String
  category   String
  uploadedAt DateTime @default(now())
}

model JobPosting {
  id         Int    @id @default(autoincrement())
  title      String
  department String
  location   String

  // Short overview shown on the Careers listing page.
  description String

  // Detailed job information shown on the Job Details page.
  responsibilities String?
  qualifications   String?
  experience       String?
  competencies     String?

  // Additional job information.
  jobCategory String?
  jobType     String?

  deadline DateTime?

  status String @default("open") // "open" | "closed"

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id    Int        @id @default(autoincrement())
  jobId Int
  job   JobPosting @relation(fields: [jobId], references: [id])

  applicantName String
  email         String
  phone         String?
  coverNote     String?

  // The generated filename or cloud object key.
  // Local example: 1722345678901-uuid.pdf
  // Future cloud example: resumes/2026/uuid.pdf
  resumeStorageKey String

  // The applicant's original filename.
  // Example: Odunayo-Ajisebutu-CV.pdf
  resumeOriginalName String

  // The detected upload type.
  // Example: application/pdf
  resumeMimeType String

  // The file size in bytes.
  resumeFileSize Int

  privacyAcknowledged   Boolean   @default(false)
  privacyAcknowledgedAt DateTime?
  privacyNoticeVersion  String?

  status      ApplicationStatus @default(NEW)
  submittedAt DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([submittedAt])
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model FAQ {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  category String @default("general")
  order    Int    @default(0)
}

model ContactSubmission {
  id      Int     @id @default(autoincrement())
  name    String
  email   String
  phone   String?
  subject String?
  message String

  status      ContactStatus @default(NEW)
  submittedAt DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([status])
  @@index([submittedAt])
}

model NewsletterSubscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model DailyDigest {
  id          Int       @id @default(autoincrement())
  title       String    @default("STIAM Daily Market Digest")
  filePath    String
  publishDate DateTime
  dayOfWeek   DayOfWeek
  createdAt   DateTime  @default(now())

  @@index([publishDate])
  @@index([dayOfWeek, publishDate])
}

model RateGuide {
  id           Int    @id
  imageUrl     String
  originalName String
  mimeType     String
  fileSize     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
